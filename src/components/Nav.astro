---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/sermons', label: 'Sermons' },
  { href: '/events', label: 'Events' },
];
const path = Astro.url.pathname;
---

<header class="bg-white border-b border-stone-200 sticky top-0 z-10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-semibold text-lg text-[#1B75BB]">Good Land NTCG</a>
    <nav class="flex gap-1 sm:gap-2">
      {links.map((l) => {
        const active = l.href === '/' ? path === '/' : path.startsWith(l.href);
        return (
          <a
            href={l.href}
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
              active ? 'bg-[#1B75BB]/10 text-[#1B75BB]' : 'text-stone-600 hover:bg-stone-100'
            }`}
          >
            {l.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
