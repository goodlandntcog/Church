---
const year = new Date().getFullYear();
---

<footer class="bg-stone-900 text-stone-300 mt-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 grid gap-8 sm:grid-cols-3 text-sm">
    <div>
      <div class="text-white font-semibold mb-2">Good Land New Testament Church of God</div>
      <p class="text-stone-400">[Street address], Barbados</p>
    </div>
    <div>
      <div class="text-white font-semibold mb-2">Service Times</div>
      <p class="text-stone-400">Sunday Worship — [time]</p>
      <p class="text-stone-400">Bible Study — [day/time]</p>
    </div>
    <div>
      <div class="text-white font-semibold mb-2">Contact</div>
      <p class="text-stone-400">[phone]</p>
      <p class="text-stone-400">[email]</p>
    </div>
  </div>
  <div class="border-t border-stone-800 py-4 text-center text-xs text-stone-500">
    &copy; {year} Good Land New Testament Church of God, Barbados. All rights reserved.
  </div>
</footer>
