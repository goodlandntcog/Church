---
import Layout from '../layouts/Layout.astro';

// Times/descriptions confirmed from the church bulletin. Outreach & Missions and Music & Worship
// still need real details — [bracketed] text pending those.
const ministries = [
  { name: 'Project 10:31 (Youth)', description: 'Every other Friday, 7:00pm. Worship, teaching, and fellowship for teens and young adults — all welcome.' },
  { name: "Men's Fellowship", description: "1st & 3rd Tuesdays, 7:00pm, on Zoom. Fellowship and teaching for the men of the church." },
  { name: "Women's Ministry", description: '2nd & 4th Wednesdays, 7:00pm, on Zoom. Fellowship and teaching for the women of the church.' },
  { name: 'Prayer & Fasting', description: '"The Engine Room of the Church" — Wednesdays, 10:00am, on Zoom. Open to everyone.' },
  { name: 'Bible Study', description: 'Thursdays, 7:00pm, on Zoom — around the Word in 90 minutes, for spiritual growth and development.' },
  { name: 'Outreach & Missions', description: '[Hamper drives, visiting the sick/elderly, community service.]' },
  { name: 'Sunday School', description: 'Sundays, 8:45am. "One of the stabilizing institutions within our society" — bring the children to join us.' },
  { name: 'Music & Worship', description: '[Choir/praise team — rehearsal times, how to join.]' },
];
---

<Layout title="Ministries" description="Ministries at Goodland New Testament Church of God, Barbados.">
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <div class="font-mono text-xs tracking-[0.22em] uppercase text-blue">Get involved</div>
    <h1 class="font-serif text-4xl font-bold text-navy mt-3">Ministries</h1>
    <p class="mt-4 text-lg text-ink2 leading-relaxed max-w-2xl">
      There's a place to serve and grow for everyone at Goodland — here's where to start.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {ministries.map((m) => (
        <div class="bg-white border border-border rounded-2xl p-6">
          <div class="w-10 h-1 rounded bg-gold" />
          <h3 class="font-serif text-xl font-semibold text-navy mt-4">{m.name}</h3>
          <p class="mt-2 text-[15px] text-ink2 leading-relaxed">{m.description}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
