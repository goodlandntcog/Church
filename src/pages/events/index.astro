---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('events')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const now = Date.now() - 24 * 60 * 60 * 1000;
const upcoming = events.filter((e) => e.data.date.valueOf() >= now);
const past = events.filter((e) => e.data.date.valueOf() < now).reverse();
---

<Layout title="Events" description="Upcoming events — Good Land New Testament Church of God, Barbados.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-14">
    <h1 class="text-3xl font-bold">Events</h1>

    <h2 class="text-xl font-semibold mt-10 mb-4">Upcoming</h2>
    <div class="space-y-4">
      {upcoming.map((e) => (
        <div class="rounded-xl border border-stone-200 p-5 flex gap-4">
          <div class="shrink-0 w-16 text-center">
            <div class="text-xs font-medium text-[#F6921E] uppercase">
              {e.data.date.toLocaleDateString('en-US', { month: 'short' })}
            </div>
            <div class="text-2xl font-bold text-stone-800">{e.data.date.getDate()}</div>
          </div>
          <div>
            <div class="font-semibold">{e.data.title}</div>
            {e.data.location && <div class="text-sm text-stone-500">{e.data.location}</div>}
            {e.data.summary && <p class="text-sm text-stone-600 mt-1">{e.data.summary}</p>}
          </div>
        </div>
      ))}
      {upcoming.length === 0 && <p class="text-stone-500">No upcoming events posted right now.</p>}
    </div>

    {past.length > 0 && (
      <>
        <h2 class="text-xl font-semibold mt-12 mb-4 text-stone-400">Past Events</h2>
        <div class="space-y-2">
          {past.map((e) => (
            <div class="text-sm text-stone-500 py-2 border-b border-stone-100 flex justify-between">
              <span>{e.data.title}</span>
              <span>{e.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </div>
          ))}
        </div>
      </>
    )}
  </section>
</Layout>
