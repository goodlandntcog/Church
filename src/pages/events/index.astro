---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('events')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const now = Date.now() - 24 * 60 * 60 * 1000;
const upcoming = events.filter((e) => e.data.date.valueOf() >= now);
const past = events.filter((e) => e.data.date.valueOf() < now).reverse();
---

<Layout title="Events" description="Upcoming events — Goodland New Testament Church of God, Barbados.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <div class="font-mono text-xs tracking-[0.22em] uppercase text-blue">What's happening</div>
    <h1 class="font-serif text-4xl font-bold text-navy mt-3">Events</h1>

    <h2 class="font-serif text-2xl font-semibold text-navy mt-11">Upcoming</h2>
    <div class="mt-4 space-y-4">
      {upcoming.map((e) => (
        <div class="bg-white border border-border rounded-2xl p-6 flex gap-[18px] items-start">
          <div class="shrink-0 w-[62px] text-center rounded-xl bg-cream-card py-2.5 px-1.5">
            <div class="font-mono text-[11px] tracking-wide uppercase text-blue">
              {e.data.date.toLocaleDateString('en-US', { month: 'short' })}
            </div>
            <div class="font-serif text-2xl font-bold text-navy leading-tight">{e.data.date.getDate()}</div>
          </div>
          <div class="min-w-0">
            <div class="font-serif text-lg font-semibold text-navy">{e.data.title}</div>
            {e.data.location && <div class="text-[15px] text-ink2 mt-0.5">{e.data.location}</div>}
            {e.data.summary && <p class="text-[15px] text-ink2 mt-1.5">{e.data.summary}</p>}
          </div>
        </div>
      ))}
      {upcoming.length === 0 && <p class="text-ink2">No upcoming events posted right now.</p>}
    </div>

    {past.length > 0 && (
      <>
        <h2 class="font-serif text-xl font-semibold text-ink2/70 mt-14">Past Events</h2>
        <div class="mt-3 space-y-1">
          {past.map((e) => (
            <div class="text-sm text-ink2 py-2 border-b border-border flex justify-between">
              <span>{e.data.title}</span>
              <span>{e.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </div>
          ))}
        </div>
      </>
    )}
  </section>
</Layout>
