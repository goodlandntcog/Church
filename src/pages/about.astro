---
import Layout from '../layouts/Layout.astro';

const serviceTimes = [
  { label: 'Morning Worship', when: 'Sunday 9:30am' },
  { label: 'Evening Service', when: 'Sunday 6:00pm' },
  { label: 'Prayer Meeting', when: 'Tuesday 7:00pm' },
  { label: 'Bible Study', when: 'Wednesday 7:00pm' },
];
---

<Layout title="About" description="About Goodland New Testament Church of God, Barbados — leadership, service times, and location.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <div class="font-mono text-xs tracking-[0.22em] uppercase text-blue">About us</div>
    <h1 class="font-serif text-4xl font-bold text-navy mt-3">Goodland New Testament Church of God</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink2">
      [A paragraph or two about the church's history, mission, and what a first-time visitor can expect.]
    </p>

    <h2 class="font-serif text-2xl font-semibold text-navy mt-12">Leadership</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-border bg-white p-5">
        <div class="font-semibold text-navy">[Pastor's name]</div>
        <div class="text-sm text-ink2 mt-0.5">Senior Pastor</div>
      </div>
    </div>

    <h2 class="font-serif text-2xl font-semibold text-navy mt-12">Service Times</h2>
    <dl class="mt-4 divide-y divide-border rounded-2xl border border-border bg-white overflow-hidden">
      {serviceTimes.map((s) => (
        <div class="flex justify-between px-5 py-3.5 text-[15px]">
          <dt class="font-semibold text-navy">{s.label}</dt>
          <dd class="text-ink2">{s.when}</dd>
        </div>
      ))}
    </dl>

    <h2 class="font-serif text-2xl font-semibold text-navy mt-12">Location</h2>
    <p class="mt-4 text-ink2">[Street address], Goodland, St. Michael, Barbados</p>
  </section>
</Layout>
