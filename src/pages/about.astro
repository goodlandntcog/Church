---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="About New Testament Church of God, Barbados — leadership, service times, and location.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-14">
    <h1 class="text-3xl font-bold">About Us</h1>
    <p class="mt-4 text-stone-600 leading-relaxed">
      [A paragraph or two about the church's history, mission, and what a first-time visitor can expect.]
    </p>

    <h2 class="text-xl font-semibold mt-10">Leadership</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-stone-200 p-5">
        <div class="font-medium">[Pastor's name]</div>
        <div class="text-sm text-stone-500">Senior Pastor</div>
      </div>
    </div>

    <h2 class="text-xl font-semibold mt-10">Service Times</h2>
    <dl class="mt-4 space-y-2 text-stone-600">
      <div class="flex justify-between max-w-sm">
        <dt>Sunday Worship</dt>
        <dd>[time]</dd>
      </div>
      <div class="flex justify-between max-w-sm">
        <dt>Bible Study</dt>
        <dd>[day/time]</dd>
      </div>
    </dl>

    <h2 class="text-xl font-semibold mt-10">Location</h2>
    <p class="mt-4 text-stone-600">[Street address], Barbados</p>
  </section>
</Layout>
