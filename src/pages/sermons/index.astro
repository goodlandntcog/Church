---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const sermons = (await getCollection('sermons')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Sermons" description="Sermon archive — Goodland New Testament Church of God, Barbados.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <div class="font-mono text-xs tracking-[0.22em] uppercase text-blue">Watch &amp; listen</div>
    <h1 class="font-serif text-4xl font-bold text-navy mt-3">Sermons</h1>
    <p class="mt-2 text-ink2">Past messages from our services.</p>

    <div class="mt-8 grid gap-4">
      {sermons.map((s) => (
        <a href={`/sermons/${s.id}`} class="block bg-white border border-border rounded-2xl p-6 hover:border-blue transition-colors">
          <div class="text-sm text-ink2">
            {s.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            {s.data.speaker && ` · ${s.data.speaker}`}
          </div>
          <div class="font-serif text-xl font-semibold text-navy mt-1">{s.data.title}</div>
          {s.data.summary && <p class="mt-1.5 text-[15px] text-ink2">{s.data.summary}</p>}
        </a>
      ))}
      {sermons.length === 0 && <p class="py-8 text-ink2">No sermons posted yet.</p>}
    </div>
  </section>
</Layout>
