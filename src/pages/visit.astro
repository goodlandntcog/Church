---
import Layout from '../layouts/Layout.astro';

const serviceTimes = [
  { label: 'Sunday School', when: 'Sunday 8:45am' },
  { label: 'Morning Worship', when: 'Sunday 10:00am' },
  { label: 'Prayer & Fasting', when: 'Wednesday 10:00am' },
  { label: 'Bible Study', when: 'Thursday 7:00pm' },
];
---

<Layout title="Visit" description="Plan your visit — Goodland New Testament Church of God, Barbados.">
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-16">
    <div class="font-mono text-xs tracking-[0.22em] uppercase text-gold">New here?</div>
    <h1 class="font-serif text-4xl font-bold text-navy mt-3">Plan your visit</h1>
    <p class="mt-4 text-lg text-ink2 leading-relaxed">
      A warm welcome awaits you. Whether you were born here, you've just moved to the island, or you're visiting for
      a week — there is a seat, a warm welcome and a cup of tea waiting for you on Sunday.
    </p>

    <h2 class="font-serif text-2xl font-semibold text-navy mt-11">What to expect</h2>
    <p class="mt-3 text-ink2 leading-relaxed">
      [A short, practical paragraph: what people wear, how long the service runs, what happens with kids, where to
      park, anything a first-timer would want to know before walking in.]
    </p>

    <h2 class="font-serif text-2xl font-semibold text-navy mt-11">Service Times</h2>
    <div class="mt-4 grid gap-2.5">
      {serviceTimes.map((s) => (
        <div class="flex justify-between px-[18px] py-[13px] rounded-xl bg-cream-card">
          <span class="font-semibold text-navy">{s.label}</span>
          <span class="text-ink2">{s.when}</span>
        </div>
      ))}
    </div>

    <h2 class="font-serif text-2xl font-semibold text-navy mt-11">Location</h2>
    <p class="mt-3 text-ink2">Goodland Main Road, St. Michael, Barbados</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/live-and-zoom" class="px-6 py-3.5 rounded-full bg-blue text-white font-bold hover:brightness-95 transition-all">
        Can't make it in person? Join online →
      </a>
    </div>
  </section>
</Layout>
