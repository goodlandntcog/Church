---
import Layout from '../layouts/Layout.astro';

const zoomSchedule = [
  { label: 'Morning Worship', when: 'Sun 9:30am · Live stream + Zoom' },
  { label: 'Evening Service', when: 'Sun 6:00pm · Zoom' },
  { label: 'Prayer Meeting', when: 'Tue 7:00pm · Zoom' },
  { label: 'Bible Study', when: 'Wed 7:00pm · Zoom' },
];
---

<Layout title="Live & Zoom" description="Watch our services live or join by Zoom — Goodland New Testament Church of God, Barbados.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <div class="font-mono text-xs tracking-[0.22em] uppercase text-orange">Live &amp; on Zoom</div>
    <h1 class="font-serif text-4xl font-bold text-navy mt-3">Can't make it in? Join us online.</h1>
    <p class="mt-4 text-lg text-ink2 leading-relaxed">
      Sunday morning streams live, and all three weekly services plus Wednesday Bible study run on Zoom — one click
      to join.
    </p>

    <div class="mt-8 grid gap-2.5">
      {zoomSchedule.map((z) => (
        <div class="flex flex-wrap gap-x-3.5 gap-y-2 items-baseline justify-between px-[18px] py-[13px] rounded-xl bg-cream-card">
          <span class="text-base font-bold text-navy">{z.label}</span>
          <span class="text-[15px] text-ink2">{z.when}</span>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-2xl border border-border bg-white p-6">
      <div class="font-serif text-xl font-semibold text-navy">Zoom link</div>
      <p class="mt-2 text-ink2">[Zoom meeting link / ID / passcode — same one for every service, or list per-service if they differ]</p>
    </div>

    <div class="mt-6 rounded-2xl border border-border bg-white p-6">
      <div class="font-serif text-xl font-semibold text-navy">Livestream</div>
      <p class="mt-2 text-ink2">
        [Link to YouTube/Facebook channel — Sunday morning worship is streamed live here. Past services also appear
        on the <a href="/sermons" class="text-blue hover:underline">Sermons</a> page.]
      </p>
    </div>
  </section>
</Layout>
