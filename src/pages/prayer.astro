---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Prayer" description="Prayer requests — Goodland New Testament Church of God, Barbados.">
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-16">
    <div class="font-mono text-xs tracking-[0.22em] uppercase text-blue">We'd love to pray with you</div>
    <h1 class="font-serif text-4xl font-bold text-navy mt-3">Prayer</h1>
    <p class="mt-4 text-lg text-ink2 leading-relaxed">
      Whatever you're facing, you don't have to carry it alone. Send us your prayer request and our prayer team
      will be praying for you.
    </p>

    <div class="mt-8 rounded-2xl border border-border bg-white p-6">
      <p class="text-ink2">
        Call or email us your request, and our pastors and prayer team will be praying with you.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="tel:+12465462228" class="px-5 py-2.5 rounded-full bg-blue text-white font-bold hover:brightness-95 transition-all">
          (246) 546-2228
        </a>
        <a href="mailto:goodlandntcog@gmail.com" class="px-5 py-2.5 rounded-full border border-border text-navy font-bold hover:bg-cream-card transition-colors">
          goodlandntcog@gmail.com
        </a>
      </div>
    </div>

    <div class="mt-8">
      <div class="font-serif text-xl font-semibold text-navy">Prayer & Fasting</div>
      <p class="mt-2 text-ink2">
        Join us in person or on Zoom — Wednesdays, 10:00am, plus Early Morning Prayer the 1st Saturday of each
        month at 6:30am. See <a href="/live-and-zoom" class="text-blue hover:underline">Live &amp; Zoom</a> for the
        link.
      </p>
    </div>
  </section>
</Layout>
