---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Prayer" description="Prayer requests — Goodland New Testament Church of God, Barbados.">
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-16">
    <div class="font-mono text-xs tracking-[0.22em] uppercase text-blue">We'd love to pray with you</div>
    <h1 class="font-serif text-4xl font-bold text-navy mt-3">Prayer</h1>
    <p class="mt-4 text-lg text-ink2 leading-relaxed">
      Whatever you're facing, you don't have to carry it alone. Send us your prayer request and our prayer team
      will be praying for you.
    </p>

    <div class="mt-8 rounded-2xl border border-border bg-white p-6">
      <p class="text-ink2">
        [Prayer request form or contact method goes here — e.g. a simple mailto: link, a phone number for the
        prayer line, or an embedded form (Google Forms, Tally, etc.) if you'd like something more structured than a
        static page can offer on its own.]
      </p>
    </div>

    <div class="mt-8">
      <div class="font-serif text-xl font-semibold text-navy">Prayer Meeting</div>
      <p class="mt-2 text-ink2">Join us in person or on Zoom — Tuesdays, 7:00pm. See <a href="/live-and-zoom" class="text-blue hover:underline">Live &amp; Zoom</a> for the link.</p>
    </div>
  </section>
</Layout>
